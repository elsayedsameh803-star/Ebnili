# --- Supabase (مطلوب) ---
# من: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- رقم محفظة Orange Cash لتحصيل الاشتراكات (مطلوب) ---
VITE_ORANGE_CASH_NUMBER=01207782741

# --- رابط الموقع الأساسي (يُستخدم في SEO ومشاركة المشاريع) ---
VITE_APP_URL=http://localhost:5173

# --- بريد المالك لاستقبال إشعارات الاشتراكات ---
VITE_ADMIN_EMAIL=admin@example.com

# --- Gemini (مطلوب للتوليد بالذكاء الاصطناعي) ---
# مهم جدًا: هذا متغير سيرفر فقط (بدون بادئة VITE_) وتُقرأه الدالة api/generate.ts.
# أي متغير يبدأ بـ VITE_ يُدمج في ملف JavaScript العام ويصبح مكشوفًا للجميع.
GEMINI_API_KEY=your-gemini-api-key-here
