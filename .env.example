# --- Supabase (مطلوب) ---
# من: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- رقم محفظة Orange Cash لتحصيل الاشتراكات (مطلوب) ---
VITE_ORANGE_CASH_NUMBER=01207782741

# --- رابط الموقع الأساسي (يُستخدم في SEO ومشاركة المشاريع) ---
VITE_APP_URL=http://localhost:5173

# --- بريد المالك لاستقبال إشعارات الاشتراكات ---
VITE_ADMIN_EMAIL=admin@example.com

# --- Gemini (مطلوب للتوليد بالذكاء الاصطناعي) ---
# التوليد يتم مباشرة من المتصفح عبر @google/genai، لذلك يبدأ المتغير بـ VITE_
# ويُدمج في حزمة JavaScript العامة (مكشوف للزوّار بحكم التصميم — الموقع فرونت إند فقط).
# قيّد المفتاح من AI Studio أو Google Cloud: Restrict to Gemini API only، واضبط الحصص،
# لأن Google تحجب تلقائيًا أي مفتاح يُكتشف كمسرّب علنًا.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- (اختياري) تثبيت موديل Gemini بدلًا من القائمة الافتراضية ---
# الافتراضي: gemini-3.8-flash ثم gemini-3.6-flash كاحتياطي عند إيقاف الموديل.
# VITE_GEMINI_MODEL=gemini-3.8-flash

# ملاحظة: إن تركت مفاتيح Supabase ناقصة أو وهمية، يعمل التطبيق تلقائيًا في
# "الوضع المحلي" (حفظ المشاريع داخل المتصفح) بدل إظهار أخطاء 404/401.
